{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "stockfish"
  ],
  "ios": {
    "iosModuleName": "NitroStockfish"
  },
  "android": {
    "androidNamespace": [
      "stockfish"
    ],
    "androidCxxLibName": "NitroStockfish"
  },
  "autolinking": {
    "StockfishFactory": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridStockfishFactory"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "third-party/**",
    ".agents/**"
  ]
}
